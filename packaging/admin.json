{
  "appId": "local.siphappens.admin",
  "productName": "Sip Happens Admin",
  "directories": {
    "output": "release/admin"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "dist/admin.cjs",
    "name": "sip-happens-admin"
  },
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "extraResources": [
    {
      "from": "packages/detect.ps1",
      "to": "detect.ps1"
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "lloydaarn",
      "repo": "sip-happens",
      "channel": "admin",
      "releaseType": "release"
    }
  ],
  "generateUpdatesFilesForAllChannels": false
}