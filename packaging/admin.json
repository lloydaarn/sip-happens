{
  "appId": "local.siphappens.admin",
  "productName": "Sip Happens Admin",
  "directories": {
    "output": "release/admin"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "dist/admin.cjs"
  },
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "extraResources": [
    {
      "from": "packages/detect.ps1",
      "to": "detect.ps1"
    }
  ]
}