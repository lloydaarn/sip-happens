{
  "name": "sip-happens",
  "version": "0.1.0",
  "private": true,
  "description": "LAN-administered hydration reminders",
  "author": "Sip Happens",
  "main": "dist/client.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "client": "npm run build && electron dist/client.cjs",
    "admin": "npm run build && electron dist/admin.cjs",
    "package:client": "npm run build && electron-builder --config packaging/client.json",
    "package:admin": "npm run build && electron-builder --config packaging/admin.json",
    "demo": "npm run build && electron dist/client.cjs --demo"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0",
    "selfsigned": "^3.0.0"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0"
  }
}